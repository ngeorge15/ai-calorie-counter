# MongoDB Atlas M0 — free forever, 512MB
MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=calorie_counter

# Long random string. `python -c "import secrets; print(secrets.token_urlsafe(48))"`
JWT_SECRET=

# USDA FoodData Central — primary barcode source.
# Free key, no credit card: https://fdc.nal.usda.gov/api-key-signup
USDA_API_KEY=

# Open Food Facts requires a real contact. OFF blocks unidentified clients.
OFF_USER_AGENT=CalorieCounter/1.0 (nikhiloneal50@gmail.com)
